<Window x:Class="AirPlayServer.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPlay connection request" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="24">
        <StackPanel x:Name="AskPanel">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEC15;" FontSize="32"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
            <TextBlock Text="Allow this AirPlay connection?" Style="{DynamicResource SubtitleTextBlockStyle}"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="A nearby Apple device wants to connect. Allow it to reveal a 4-digit PIN."
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="RemoteText" Style="{StaticResource Description}" Margin="0,4,0,0"/>
            <UniformGrid Columns="2" Margin="0,24,0,0">
                <Button Content="Allow" Margin="0,0,4,0" HorizontalAlignment="Stretch" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" Click="Allow_Click"/>
                <Button Content="Deny" Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="Deny_Click"/>
            </UniformGrid>
        </StackPanel>

        <StackPanel x:Name="FailedPanel" Visibility="Collapsed">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="32"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
            <TextBlock Text="PIN kept private" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
            <TextBlock Text="Windows could not exclude this window from screen capture, so the PIN was not shown."
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Button Content="Cancel connection" Margin="0,24,0,0" HorizontalAlignment="Stretch" Click="Cancel_Click"/>
        </StackPanel>

        <StackPanel x:Name="PinPanel" Visibility="Collapsed">
            <TextBlock Text="Connection approved" Style="{DynamicResource SubtitleTextBlockStyle}"/>
            <TextBlock Text="Enter this PIN on your Apple device:" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
                <TextBlock x:Name="PinText" Text="----" FontSize="44" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>
            <Button Content="Cancel" Margin="0,24,0,0" HorizontalAlignment="Stretch" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
