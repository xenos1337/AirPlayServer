<Window x:Class="AirPlayServer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" Height="680" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Quit AirPlay Server" Click="Quit_Click"/>
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="96" IsCancel="True"
                        Style="{DynamicResource AccentButtonStyle}"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">
                <TextBlock Text="Settings" Style="{DynamicResource TitleTextBlockStyle}"/>

                <TextBlock Text="Receiver" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBox x:Name="NameBox" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"
                                 TextChanged="NameBox_TextChanged"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Receiver name"/>
                            <TextBlock Style="{StaticResource Description}"
                                       Text="Shown in Screen Mirroring. Changes apply automatically when disconnected. Chinese characters are not supported."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox x:Name="ResolutionCombo" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"
                                      SelectionChanged="Resolution_SelectionChanged">
                                <ComboBoxItem x:Name="MatchMonitorItem" Content="Match monitor"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="AirPlay resolution"/>
                                <TextBlock Style="{StaticResource Description}"
                                           Text="Resolution macOS uses for a new mirrored display. Applied while idle; reconnect from macOS after changing it."/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="CustomSizePanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBox x:Name="WidthBox" Width="96" PreviewTextInput="Digits_PreviewTextInput"
                                     LostKeyboardFocus="Size_LostKeyboardFocus" KeyDown="Size_KeyDown"/>
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="HeightBox" Width="96" PreviewTextInput="Digits_PreviewTextInput"
                                     LostKeyboardFocus="Size_LostKeyboardFocus" KeyDown="Size_KeyDown"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Viewer" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="AutoFullscreenCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="Option_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Enter fullscreen when a device connects"/>
                            <TextBlock Style="{StaticResource Description}"
                                       Text="Use borderless fullscreen for each new AirPlay session"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="MinimizeOnCloseCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="Option_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Hide to system tray when closing the window"/>
                            <TextBlock Style="{StaticResource Description}"
                                       Text="When idle, the close button hides the window; use Quit here or in the tray menu to exit"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="HideOnDisconnectCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="Option_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Hide to system tray after disconnecting"/>
                            <TextBlock Style="{StaticResource Description}"
                                       Text="Keep the receiver running in the system tray when an AirPlay session ends"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="AutoStartCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="AutoStart_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start AirPlay Server when you sign in"/>
                            <TextBlock Style="{StaticResource Description}"
                                       Text="Starts in the system tray for the current user"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="CheckForUpdatesCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="Option_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Check for updates"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Description}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Security" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="RequirePinCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="Option_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Require PIN"/>
                            <TextBlock x:Name="PinDescription" Style="{StaticResource Description}"/>
                            <TextBlock x:Name="PinWarning" Style="{StaticResource Warning}"
                                       Text="PIN approval is unreliable with MacBooks/macOS."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="HidePinCard" Style="{StaticResource Card}">
                    <DockPanel>
                        <CheckBox x:Name="HidePinCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="Option_Click"/>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Hide PIN from screen capture"/>
                            <TextBlock Style="{StaticResource Description}"
                                       Text="Exclude the PIN window from recordings before the PIN is shown"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
