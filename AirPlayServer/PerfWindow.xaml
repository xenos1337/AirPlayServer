<Window x:Class="AirPlayServer.PerfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AirPlayServer"
        Title="Diagnostics" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="False"
        KeyUp="Window_KeyUp">
    <Window.Resources>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Chart" TargetType="local:Sparkline">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="GuideStroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Text="Live" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
        <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,4,4">
                <StackPanel>
                    <TextBlock Text="Source fps" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="SourceFpsText" Style="{StaticResource Metric}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0,2,4">
                <StackPanel>
                    <TextBlock Text="Display fps" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="DisplayFpsText" Style="{StaticResource Metric}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,0,4">
                <StackPanel>
                    <TextBlock Text="Frame time" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="FrameTimeText" Style="{StaticResource Metric}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,4,4">
                <StackPanel>
                    <TextBlock Text="Latency" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="LatencyText" Style="{StaticResource Metric}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0,2,4">
                <StackPanel>
                    <TextBlock Text="Bitrate" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="BitrateText" Style="{StaticResource Metric}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,0,4">
                <StackPanel>
                    <TextBlock Text="Audio buffer" Style="{StaticResource Description}"/>
                    <TextBlock x:Name="BufferText" Style="{StaticResource Metric}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Last 30 seconds" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,2,4">
                <StackPanel>
                    <TextBlock Text="Frame time · 0-33 ms" Style="{StaticResource Description}"/>
                    <local:Sparkline x:Name="FrameTimeChart" Style="{StaticResource Chart}" Maximum="33" Guide="16.67"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0,0,4">
                <StackPanel>
                    <TextBlock Text="Bitrate · 0-50 Mbps" Style="{StaticResource Description}"/>
                    <local:Sparkline x:Name="BitrateChart" Style="{StaticResource Chart}" Maximum="50"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,2,4">
                <StackPanel>
                    <TextBlock Text="Source fps · 0-80" Style="{StaticResource Description}"/>
                    <local:Sparkline x:Name="SourceFpsChart" Style="{StaticResource Chart}" Maximum="80"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0,0,4">
                <StackPanel>
                    <TextBlock Text="Display fps · 0-80" Style="{StaticResource Description}"/>
                    <local:Sparkline x:Name="DisplayFpsChart" Style="{StaticResource Chart}" Maximum="80"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,2,4">
                <StackPanel>
                    <TextBlock Text="Decode latency · 0-33 ms" Style="{StaticResource Description}"/>
                    <local:Sparkline x:Name="LatencyChart" Style="{StaticResource Chart}" Maximum="33" Guide="16.67"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0,0,4">
                <StackPanel>
                    <TextBlock Text="Audio buffer · 0-20 frames" Style="{StaticResource Description}"/>
                    <local:Sparkline x:Name="AudioQueueChart" Style="{StaticResource Chart}" Maximum="20"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Columns="2">
            <StackPanel Margin="0,0,2,0">
                <TextBlock Text="Session" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Video" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VideoText" Margin="0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="Transferred" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TransferredText" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Text="Frames" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FramesText" Margin="0,2" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="Uptime" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UptimeText" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Text="Receiver" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ReceiverText" Margin="0,2"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Margin="2,0,0,0">
                <TextBlock Text="Rendering" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Renderer" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RendererText" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="Target" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetText" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Text="Zoom" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ZoomText" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Text="Rotation" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RotationText" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Text="Clean feed" Style="{StaticResource Description}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CleanFeedText" Margin="0,2"/>
                    </Grid>
                </Border>
            </StackPanel>
        </UniformGrid>

        <TextBlock Text="Audio" Style="{StaticResource SectionHeader}"/>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Sample rate" Style="{StaticResource Description}" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SampleRateText" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="Sender volume" Style="{StaticResource Description}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SenderVolumeText" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Input level" Style="{StaticResource Description}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="InputLevelText" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Underruns" Style="{StaticResource Description}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UnderrunsText" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Dropped" Style="{StaticResource Description}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="AudioDroppedText" Margin="0,2"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
